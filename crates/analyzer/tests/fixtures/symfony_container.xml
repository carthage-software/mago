<?xml version="1.0" encoding="utf-8"?>
<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
  <services>
    <service id="app.mailer" class="App\Service\Mailer" public="true">
      <argument type="service" id="app.transport"/>
    </service>
    <service id="app.transport" class="App\Service\SmtpTransport"/>
    <service id="App\Service\MailerInterface" alias="app.mailer" public="true"/>
  </services>
</container>
